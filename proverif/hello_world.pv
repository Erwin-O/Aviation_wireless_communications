(*
 * hello_world.pv
 *
 * A minimal ProVerif example used to confirm that the ProVerif
 * installation is working before we start on the real protocol model.
 *
 * Models: a sender encrypts a secret message under a symmetric key
 *         shared with a receiver and transmits the ciphertext over a
 *         public network channel.
 *
 * Verifies: a Dolev-Yao network attacker, who observes the ciphertext
 *           but does not hold the shared key, cannot derive the secret.
 *
 * Expected result (look for this line at the end of the output):
 *
 *   RESULT not attacker(hello_secret[]) is true.
 *)


(* ------------------------------------------------------------------ *)
(* Type declarations                                                  *)
(* ------------------------------------------------------------------ *)

type key.


(* ------------------------------------------------------------------ *)
(* Cryptographic primitives                                           *)
(* ------------------------------------------------------------------ *)

(* Perfect symmetric encryption.
   The equation sdec(senc(m, k), k) = m says that decryption with the
   correct key inverts encryption. Without k, the ciphertext is opaque
   to the attacker. *)
fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key;
  sdec(senc(m, k), k) = m.


(* ------------------------------------------------------------------ *)
(* Free names                                                         *)
(* ------------------------------------------------------------------ *)

(* A public network channel, fully under the attacker's control. *)
free c: channel.

(* A long-term symmetric key, shared by the legitimate parties only.
   Marked [private] so the attacker does not start out knowing it. *)
free k_AB: key [private].

(* The secret bitstring we want to protect. *)
free hello_secret: bitstring [private].


(* ------------------------------------------------------------------ *)
(* Security query                                                     *)
(* ------------------------------------------------------------------ *)

(* "Can the attacker derive hello_secret from anything it observes?"
   ProVerif tries to prove that the answer is no. *)
query attacker(hello_secret).


(* ------------------------------------------------------------------ *)
(* Protocol                                                           *)
(* ------------------------------------------------------------------ *)

(* The single legitimate process: send senc(hello_secret, k_AB) on c.
   We replicate the process (the leading "!") so that the model
   considers an unbounded number of sessions, matching how the real
   protocol would actually be used. *)
process
  ! out(c, senc(hello_secret, k_AB))
