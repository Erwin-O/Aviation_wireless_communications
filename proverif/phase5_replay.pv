(*
 * phase5_replay.pv
 *
 * Phase 5 of the formal verification of the air-ground communication
 * protocol. Strengthens the Phase 4 correspondences to INJECTIVE form
 * for the operational messages and the KEYCONFIRM / KEYACK derivations,
 * capturing the cross-session replay resistance property G6 from
 * Section 5.1 of the paper.
 *
 * Properties verified in this phase (additions / changes shown):
 *
 *   G1 -- (carried over implicitly via G5)
 *   G2 -- aircraft authentication                       (non-injective)
 *   G3 -- ground-station authentication                 (injective, new strength)
 *   G4 -- operational message integrity                 (injective, new strength)
 *   G5 -- session isolation                             (carried over)
 *   G6 -- replay resistance (cross-session)             (subsumed by injectivity)
 *   G7 -- handshake transcript agreement                (injective, new strength)
 *
 * G2 IS INJECTIVE WHEN MEASURED AT SESSION ESTABLISHMENT.
 * The paper's G2 says: "If G accepts a session established with aircraft A,
 * then A must have initiated that session." The trigger event is the
 * SESSION ESTABLISHMENT, i.e., a successful KEYCONFIRM verification
 * (groundAcceptsConfirm), not the initial KEY signature verification
 * (groundAcceptsKey).
 *
 * If an attacker replays a signed KEY to multiple ground1 instances, each
 * verifies the signature (they share the long-term key) and emits its own
 * KEYACK with a fresh ephemeral. The aircraft accepts exactly one of these
 * KEYACKs and proceeds; the others sit idle because the aircraft's
 * KEYCONFIRM, which is transcript-bound to the chosen KEYACK, cannot be
 * verified on them. Only one ground1 instance ever completes the
 * handshake (fires groundAcceptsConfirm). Cross-station replay is also
 * prevented automatically: the TO field of the canonical message is
 * matched literally by each receiver, so a KEY addressed to G1 cannot be
 * accepted by G2.
 *
 * Therefore the SESSION-LEVEL form of G2 holds injectively: each
 * groundAcceptsConfirm event maps to a distinct aircraftSentKey event.
 * The intermediate groundAcceptsKey event is no longer queried; it fires
 * multiple times under replay, but this is an artefact of measuring at
 * the wrong event, not a security weakness.
 *
 * WHY G3, G4 AND G7 ARE INJECTIVE.
 * All of KEYACK, KEYCONFIRM, SA, CC and ACK are MAC-bound to K_sess,
 * which depends on freshly generated ephemerals on both sides. A replay
 * to a fresh receiver instance fails MAC verification because the
 * receiver's K_sess differs. The receiver state machine is sequential
 * (each in(c, ...) input is consumed exactly once and the process
 * advances), so a single receiver cannot accept the same message
 * twice. Therefore each *Accepts event maps to a distinct *Sent event.
 *
 * WITHIN-SESSION REPLAY (residual risk).
 * The symbolic model captures cross-session replay resistance. It does
 * NOT capture within-session replay resistance in a meaningful way --
 * timestamps are not modelled and ProVerif has no notion of operational
 * time. The paper acknowledges this explicitly in A3. Sequence numbers
 * are deliberately NOT introduced: the protocol's design philosophy is
 * that operational messages are independent except for the ACK that is
 * bound to its CC instruction. Within the symbolic model the receiver
 * state machine already accepts each message position exactly once, so
 * the injective queries pass; in a real deployment, duplicate filtering
 * at the application layer (timestamp window) is required to enforce
 * the same property under timing uncertainty. Multiple legitimate
 * concurrent sessions with different ground stations are not a security
 * issue: the canonical TO field is matched literally by each receiver,
 * so messages addressed to one ground station cannot be misdelivered to
 * another.
 *
 * PHASE STRUCTURE (carried over from Phase 4).
 *   Phase 0: normal protocol execution.
 *   Phase 1: post-session compromise (leak of K_sess^(1)).
 *
 * Run with:
 *   proverif phase5_replay.pv
 *
 * Look for seven RESULT lines, each ending in "is true".
 *)


(* ================================================================== *)
(* Type declarations                                                  *)
(* ================================================================== *)

type host.
type sessionid.
type sskey.
type spkey.
type dhkey.
type element.
type skey.


(* ================================================================== *)
(* Cryptographic primitives                                           *)
(* ================================================================== *)

fun spk(sskey): spkey.
fun sign(bitstring, sskey): bitstring.
reduc forall m: bitstring, sk: sskey;
  verify(sign(m, sk), spk(sk), m) = true.

const g: element.
fun exp(element, dhkey): element.
equation forall x: dhkey, y: dhkey;
  exp(exp(g, x), y) = exp(exp(g, y), x).

fun kdf(element, sessionid): skey.

fun mac(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey;
  verifymac(mac(m, k), k, m) = true.

fun hash(bitstring): bitstring.

fun senc(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey;
  sdec(senc(m, k), k) = m.

fun hostToBs(host): bitstring [data].


(* ================================================================== *)
(* Canonical message constructors                                     *)
(* ================================================================== *)

fun mkKey(host, host, sessionid, spkey, element): bitstring [data].
fun mkKeyAck(host, host, sessionid, element): bitstring [data].
fun mkKeyConfirm(host, host, sessionid, bitstring): bitstring [data].
fun mkSA(host, host, sessionid, bitstring): bitstring [data].
fun mkCC(host, host, sessionid, bitstring, bitstring): bitstring [data].
fun mkAck(host, host, sessionid, bitstring): bitstring [data].


(* ================================================================== *)
(* Channels and free names                                            *)
(* ================================================================== *)

free c: channel.
free A: host.
free G1: host.
free G2: host.
free Ksess2_test: bitstring [private].
free typeINSTRUCTION: bitstring.
free typeCONTACT: bitstring.


(* ================================================================== *)
(* Events                                                             *)
(* ================================================================== *)

event aircraftSentKey(host, host, sessionid).
event groundAcceptsKey(host, host, sessionid).
event groundSentKeyAck(host, host, sessionid).
event aircraftDerivesKsess(host, host, sessionid).
event aircraftSentConfirm(host, host, sessionid, bitstring).
event groundAcceptsConfirm(host, host, sessionid, bitstring).
event aircraftSentSA(host, host, sessionid, bitstring).
event groundAcceptsSA(host, host, sessionid, bitstring).
event groundSentCC(host, host, sessionid, bitstring, bitstring).
event aircraftAcceptsCC(host, host, sessionid, bitstring, bitstring).
event aircraftSentAck(host, host, sessionid, bitstring).
event groundAcceptsAck(host, host, sessionid, bitstring).


(* ================================================================== *)
(* Security queries                                                   *)
(* ================================================================== *)

(* G5 (carried over). *)
query attacker(Ksess2_test).

(* G2 -- aircraft authentication, measured at SESSION ESTABLISHMENT.
   The paper's G2 ("If G accepts a session established with aircraft A,
   then A must have initiated that session.") triggers on
   groundAcceptsConfirm, not on groundAcceptsKey. The intermediate
   groundAcceptsKey event fires multiple times under signed-KEY replay,
   but only one ground1 instance ever completes the handshake, so the
   session-level form holds injectively. *)
query a: host, gs: host, s: sessionid, t: bitstring;
  inj-event(groundAcceptsConfirm(a, gs, s, t)) ==>
    inj-event(aircraftSentKey(a, gs, s)).

(* G3 -- ground-station authentication. Injective: each
   aircraftDerivesKsess corresponds to a distinct groundSentKeyAck. *)
query a: host, gs: host, s: sessionid;
  inj-event(aircraftDerivesKsess(a, gs, s)) ==>
    inj-event(groundSentKeyAck(a, gs, s)).

(* G7 -- handshake transcript agreement. Injective. *)
query a: host, gs: host, s: sessionid, t: bitstring;
  inj-event(groundAcceptsConfirm(a, gs, s, t)) ==>
    inj-event(aircraftSentConfirm(a, gs, s, t)).

(* G4 -- operational message integrity. Injective: each *Accepts event
   maps to a distinct *Sent event with the same arguments. *)
query a: host, gs: host, s: sessionid, p: bitstring;
  inj-event(groundAcceptsSA(a, gs, s, p)) ==>
    inj-event(aircraftSentSA(a, gs, s, p)).

query a: host, gs: host, s: sessionid, t: bitstring, b: bitstring;
  inj-event(aircraftAcceptsCC(a, gs, s, t, b)) ==>
    inj-event(groundSentCC(a, gs, s, t, b)).

query a: host, gs: host, s: sessionid, h: bitstring;
  inj-event(groundAcceptsAck(a, gs, s, h)) ==>
    inj-event(aircraftSentAck(a, gs, s, h)).


(* ================================================================== *)
(* Aircraft process (identical to Phase 4, including the phase-1     *)
(* leak for G5).                                                     *)
(* ================================================================== *)

let aircraft(skA_sig: sskey, pkG1_sig: spkey, pkG2_sig: spkey) =
  (* === Session 1 with G1 === *)
  new s1: sessionid;
  new skA_eph1: dhkey;
  let pkA_eph1 = exp(g, skA_eph1) in
  let mKEY1 = mkKey(A, G1, s1, spk(skA_sig), pkA_eph1) in
  let sigA1 = sign(mKEY1, skA_sig) in
  event aircraftSentKey(A, G1, s1);
  out(c, (mKEY1, sigA1));

  in(c, (mKEYACK1_bs: bitstring, sigG1: bitstring));
  let mkKeyAck(=G1, =A, =s1, pkG_eph1: element) = mKEYACK1_bs in
  if verify(sigG1, pkG1_sig, mKEYACK1_bs) = true then
  let z1 = exp(pkG_eph1, skA_eph1) in
  let ksess1 = kdf(z1, s1) in
  event aircraftDerivesKsess(A, G1, s1);

  let tau1 = hash((mKEY1, mKEYACK1_bs)) in
  let mKEYCONFIRM1 = mkKeyConfirm(A, G1, s1, tau1) in
  let tKC1 = mac(mKEYCONFIRM1, ksess1) in
  event aircraftSentConfirm(A, G1, s1, tau1);
  out(c, (mKEYCONFIRM1, tKC1));

  new payload_SA1: bitstring;
  let mSA1 = mkSA(A, G1, s1, payload_SA1) in
  let tSA1 = mac(mSA1, ksess1) in
  event aircraftSentSA(A, G1, s1, payload_SA1);
  out(c, (mSA1, tSA1));

  in(c, (mCC1_bs: bitstring, tCC1: bitstring));
  let mkCC(=G1, =A, =s1, cc1_type: bitstring, cc1_body: bitstring) = mCC1_bs in
  if verifymac(tCC1, ksess1, mCC1_bs) = true then
  event aircraftAcceptsCC(A, G1, s1, cc1_type, cc1_body);

  if cc1_type = typeCONTACT then
  let hostToBs(target: host) = cc1_body in

  (* === Session 2 with target (expected G2) === *)
  new s2: sessionid;
  new skA_eph2: dhkey;
  let pkA_eph2 = exp(g, skA_eph2) in
  let mKEY2 = mkKey(A, target, s2, spk(skA_sig), pkA_eph2) in
  let sigA2 = sign(mKEY2, skA_sig) in
  event aircraftSentKey(A, target, s2);
  out(c, (mKEY2, sigA2));

  in(c, (mKEYACK2_bs: bitstring, sigG2: bitstring));
  let mkKeyAck(=target, =A, =s2, pkG_eph2: element) = mKEYACK2_bs in
  if verify(sigG2, pkG2_sig, mKEYACK2_bs) = true then
  let z2 = exp(pkG_eph2, skA_eph2) in
  let ksess2 = kdf(z2, s2) in
  event aircraftDerivesKsess(A, target, s2);

  let tau2 = hash((mKEY2, mKEYACK2_bs)) in
  let mKEYCONFIRM2 = mkKeyConfirm(A, target, s2, tau2) in
  let tKC2 = mac(mKEYCONFIRM2, ksess2) in
  event aircraftSentConfirm(A, target, s2, tau2);
  out(c, (mKEYCONFIRM2, tKC2));

  new payload_SA2: bitstring;
  let mSA2 = mkSA(A, target, s2, payload_SA2) in
  let tSA2 = mac(mSA2, ksess2) in
  event aircraftSentSA(A, target, s2, payload_SA2);
  out(c, (mSA2, tSA2));

  in(c, (mCC2_bs: bitstring, tCC2: bitstring));
  let mkCC(=target, =A, =s2, cc2_type: bitstring, cc2_body: bitstring) = mCC2_bs in
  if verifymac(tCC2, ksess2, mCC2_bs) = true then
  event aircraftAcceptsCC(A, target, s2, cc2_type, cc2_body);

  let ack_hash2 = hash(mCC2_bs) in
  let mACK2 = mkAck(A, target, s2, ack_hash2) in
  let tACK2 = mac(mACK2, ksess2) in
  event aircraftSentAck(A, target, s2, ack_hash2);
  out(c, (mACK2, tACK2));

  (* G5 test setup (phase 0) *)
  out(c, senc(Ksess2_test, ksess2));

  (* Phase 1: post-session compromise of K_sess^(1) *)
  phase 1;
  out(c, ksess1).


(* ================================================================== *)
(* Ground 1 process (identical to Phase 4).                          *)
(* ================================================================== *)

let ground1(skG1_sig: sskey, pkA_sig: spkey) =
  in(c, (mKEY_bs: bitstring, sigA: bitstring));
  let mkKey(=A, =G1, s: sessionid, pkA_sig_in: spkey, pkA_eph: element) = mKEY_bs in
  if pkA_sig_in = pkA_sig then
  if verify(sigA, pkA_sig, mKEY_bs) = true then
  event groundAcceptsKey(A, G1, s);

  new skG_eph: dhkey;
  let pkG_eph = exp(g, skG_eph) in
  let mKEYACK = mkKeyAck(G1, A, s, pkG_eph) in
  let sigG = sign(mKEYACK, skG1_sig) in
  event groundSentKeyAck(A, G1, s);
  out(c, (mKEYACK, sigG));
  let z = exp(pkA_eph, skG_eph) in
  let ksess = kdf(z, s) in

  in(c, (mKEYCONFIRM_bs: bitstring, tKC: bitstring));
  let mkKeyConfirm(=A, =G1, =s, tau_recv: bitstring) = mKEYCONFIRM_bs in
  let tau_local = hash((mKEY_bs, mKEYACK)) in
  if tau_recv = tau_local then
  if verifymac(tKC, ksess, mKEYCONFIRM_bs) = true then
  event groundAcceptsConfirm(A, G1, s, tau_local);

  in(c, (mSA_bs: bitstring, tSA: bitstring));
  let mkSA(=A, =G1, =s, payload_recv: bitstring) = mSA_bs in
  if verifymac(tSA, ksess, mSA_bs) = true then
  event groundAcceptsSA(A, G1, s, payload_recv);

  let cc_body = hostToBs(G2) in
  let mCC = mkCC(G1, A, s, typeCONTACT, cc_body) in
  let tCC = mac(mCC, ksess) in
  event groundSentCC(A, G1, s, typeCONTACT, cc_body);
  out(c, (mCC, tCC)).


(* ================================================================== *)
(* Ground 2 process (identical to Phase 4).                          *)
(* ================================================================== *)

let ground2(skG2_sig: sskey, pkA_sig: spkey) =
  in(c, (mKEY_bs: bitstring, sigA: bitstring));
  let mkKey(=A, =G2, s: sessionid, pkA_sig_in: spkey, pkA_eph: element) = mKEY_bs in
  if pkA_sig_in = pkA_sig then
  if verify(sigA, pkA_sig, mKEY_bs) = true then
  event groundAcceptsKey(A, G2, s);

  new skG_eph: dhkey;
  let pkG_eph = exp(g, skG_eph) in
  let mKEYACK = mkKeyAck(G2, A, s, pkG_eph) in
  let sigG = sign(mKEYACK, skG2_sig) in
  event groundSentKeyAck(A, G2, s);
  out(c, (mKEYACK, sigG));
  let z = exp(pkA_eph, skG_eph) in
  let ksess = kdf(z, s) in

  in(c, (mKEYCONFIRM_bs: bitstring, tKC: bitstring));
  let mkKeyConfirm(=A, =G2, =s, tau_recv: bitstring) = mKEYCONFIRM_bs in
  let tau_local = hash((mKEY_bs, mKEYACK)) in
  if tau_recv = tau_local then
  if verifymac(tKC, ksess, mKEYCONFIRM_bs) = true then
  event groundAcceptsConfirm(A, G2, s, tau_local);

  in(c, (mSA_bs: bitstring, tSA: bitstring));
  let mkSA(=A, =G2, =s, payload_recv: bitstring) = mSA_bs in
  if verifymac(tSA, ksess, mSA_bs) = true then
  event groundAcceptsSA(A, G2, s, payload_recv);

  new cc_body: bitstring;
  let mCC = mkCC(G2, A, s, typeINSTRUCTION, cc_body) in
  let tCC = mac(mCC, ksess) in
  event groundSentCC(A, G2, s, typeINSTRUCTION, cc_body);
  out(c, (mCC, tCC));

  in(c, (mACK_bs: bitstring, tACK: bitstring));
  let mkAck(=A, =G2, =s, ack_hash_recv: bitstring) = mACK_bs in
  if verifymac(tACK, ksess, mACK_bs) = true then
  event groundAcceptsAck(A, G2, s, ack_hash_recv).


(* ================================================================== *)
(* Main process                                                       *)
(* ================================================================== *)

process
  new skA_sig: sskey;
  new skG1_sig: sskey;
  new skG2_sig: sskey;
  let pkA_sig = spk(skA_sig) in
  let pkG1_sig = spk(skG1_sig) in
  let pkG2_sig = spk(skG2_sig) in
  out(c, (pkA_sig, pkG1_sig, pkG2_sig));
  (   ! aircraft(skA_sig, pkG1_sig, pkG2_sig)
    | ! ground1(skG1_sig, pkA_sig)
    | ! ground2(skG2_sig, pkA_sig) )
