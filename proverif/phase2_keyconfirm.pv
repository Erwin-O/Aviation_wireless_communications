(*
 * phase2_keyconfirm.pv
 *
 * Phase 2 of the formal verification of the air-ground communication
 * protocol. Extends phase1_handshake.pv with the third leg of the
 * handshake (KEYCONFIRM), which carries a SHA-256 transcript hash of
 * the canonical KEY and KEYACK message bodies and an Ascon-MAC under
 * the derived session key.
 *
 * Properties verified in this phase:
 *
 *   G1 -- session-key secrecy                       (carried over)
 *   G2 -- aircraft authentication                   (carried over)
 *   G3 -- ground-station authentication             (carried over)
 *   G7 -- handshake transcript agreement            (new)
 *
 * G7 captures the explicit completion guarantee provided by the third
 * leg: if the ground station marks a session as established (i.e., has
 * accepted a valid KEYCONFIRM), then the aircraft sent that very
 * KEYCONFIRM with the same transcript hash. The collision resistance
 * of SHA-256 together with the unforgeability of Ascon-MAC under K_sess
 * means the two parties necessarily agree on every bit of the canonical
 * KEY and KEYACK messages they exchanged.
 *
 * Attack A12 (handshake re-binding) is defeated as a corollary of G7:
 * if an attacker substitutes a different KEYACK between the aircraft
 * and the ground station, the locally computed transcript hashes
 * diverge and the ground's KEYCONFIRM verification fails.
 *
 * Run with:
 *   proverif phase2_keyconfirm.pv
 *
 * Look for four RESULT lines, each ending in "is true":
 *   RESULT not attacker(Ksess_test[]) is true.                       (G1)
 *   RESULT ...groundAcceptsKey... ==> ...aircraftSentKey... is true.     (G2)
 *   RESULT ...aircraftDerivesKsess... ==> ...groundSentKeyAck... is true. (G3)
 *   RESULT ...groundAcceptsConfirm... ==> ...aircraftSentConfirm... is true. (G7)
 *)


(* ================================================================== *)
(* Type declarations                                                  *)
(* ================================================================== *)

type host.
type sessionid.
type sskey.
type spkey.
type dhkey.
type element.
type skey.


(* ================================================================== *)
(* Cryptographic primitives                                           *)
(* ================================================================== *)

(* Ed25519 signatures. *)
fun spk(sskey): spkey.
fun sign(bitstring, sskey): bitstring.
reduc forall m: bitstring, sk: sskey;
  verify(sign(m, sk), spk(sk), m) = true.

(* X25519 Diffie-Hellman. *)
const g: element.
fun exp(element, dhkey): element.
equation forall x: dhkey, y: dhkey;
  exp(exp(g, x), y) = exp(exp(g, y), x).

(* HKDF-style key derivation. *)
fun kdf(element, sessionid): skey.

(* Ascon-MAC. The destructor verifymac(mac(m, k), k, m) = true captures
   ideal MAC security: forgery without k is impossible.               *)
fun mac(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey;
  verifymac(mac(m, k), k, m) = true.

(* SHA-256, used to compute the handshake transcript hash.
   Modelled as a free function symbol, so collision and preimage
   resistance hold automatically in the symbolic model.              *)
fun hash(bitstring): bitstring.

(* Symmetric encryption, used only as the G1 secrecy test harness.  *)
fun senc(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey;
  sdec(senc(m, k), k) = m.


(* ================================================================== *)
(* Canonical message constructors                                     *)
(* ================================================================== *)

(* m_KEY = FROM, TO, SID, SIGNING_KEY, EPHEMERAL_KEY *)
fun mkKey(host, host, sessionid, spkey, element): bitstring [data].

(* m_KEYACK = FROM, TO, SID, EPHEMERAL_KEY *)
fun mkKeyAck(host, host, sessionid, element): bitstring [data].

(* m_KEYCONFIRM = FROM, TO, SID, TRANSCRIPT *)
(* The final MAC field is transmitted alongside m_KEYCONFIRM but not
   covered by the canonical body; the MAC is computed over the body. *)
fun mkKeyConfirm(host, host, sessionid, bitstring): bitstring [data].


(* ================================================================== *)
(* Channels and free names                                            *)
(* ================================================================== *)

free c: channel.
free A: host.
free G: host.
free Ksess_test: bitstring [private].


(* ================================================================== *)
(* Events                                                             *)
(* ================================================================== *)

event aircraftSentKey(host, host, sessionid).
event groundAcceptsKey(host, host, sessionid).
event groundSentKeyAck(host, host, sessionid).
event aircraftDerivesKsess(host, host, sessionid).
event aircraftSentConfirm(host, host, sessionid, bitstring).
event groundAcceptsConfirm(host, host, sessionid, bitstring).


(* ================================================================== *)
(* Security queries                                                   *)
(* ================================================================== *)

(* G1 -- session-key secrecy. *)
query attacker(Ksess_test).

(* G2 -- aircraft authentication. *)
query a: host, gs: host, s: sessionid;
  event(groundAcceptsKey(a, gs, s)) ==> event(aircraftSentKey(a, gs, s)).

(* G3 -- ground-station authentication. *)
query a: host, gs: host, s: sessionid;
  event(aircraftDerivesKsess(a, gs, s)) ==> event(groundSentKeyAck(a, gs, s)).

(* G7 -- handshake transcript agreement.
   If the ground station marks the session as established (groundAcceptsConfirm
   fires with a particular transcript hash t), then the aircraft must have
   sent the corresponding KEYCONFIRM with the same transcript hash.    *)
query a: host, gs: host, s: sessionid, t: bitstring;
  event(groundAcceptsConfirm(a, gs, s, t)) ==>
    event(aircraftSentConfirm(a, gs, s, t)).


(* ================================================================== *)
(* Aircraft process                                                   *)
(* ================================================================== *)

let aircraft(skA_sig: sskey, pkG_sig: spkey) =
  (* Step 1: KEY *)
  new s: sessionid;
  new skA_eph: dhkey;
  let pkA_eph = exp(g, skA_eph) in
  let mKEY = mkKey(A, G, s, spk(skA_sig), pkA_eph) in
  let sigA = sign(mKEY, skA_sig) in
  event aircraftSentKey(A, G, s);
  out(c, (mKEY, sigA));
  (* Step 2: wait for KEYACK, verify, derive K_sess. *)
  in(c, (mKEYACK_bs: bitstring, sigG: bitstring));
  let mkKeyAck(=G, =A, =s, pkG_eph: element) = mKEYACK_bs in
  if verify(sigG, pkG_sig, mKEYACK_bs) = true then
  let z = exp(pkG_eph, skA_eph) in
  let ksess = kdf(z, s) in
  event aircraftDerivesKsess(A, G, s);
  (* Step 3: build KEYCONFIRM, with transcript hash tau over the
     canonical KEY and KEYACK bodies (NOT including their signatures). *)
  let tau = hash((mKEY, mKEYACK_bs)) in
  let mKEYCONFIRM = mkKeyConfirm(A, G, s, tau) in
  let tKC = mac(mKEYCONFIRM, ksess) in
  event aircraftSentConfirm(A, G, s, tau);
  out(c, (mKEYCONFIRM, tKC));
  (* G1 test harness: encrypt the test secret under K_sess.          *)
  out(c, senc(Ksess_test, ksess)).


(* ================================================================== *)
(* Ground-station process                                             *)
(* ================================================================== *)

let ground(skG_sig: sskey, pkA_sig: spkey) =
  (* Step 1: receive KEY, verify. *)
  in(c, (mKEY_bs: bitstring, sigA: bitstring));
  let mkKey(=A, =G, s: sessionid, pkA_sig_in: spkey, pkA_eph: element) = mKEY_bs in
  if pkA_sig_in = pkA_sig then
  if verify(sigA, pkA_sig, mKEY_bs) = true then
  event groundAcceptsKey(A, G, s);
  (* Step 2: build, sign, send KEYACK; derive K_sess. *)
  new skG_eph: dhkey;
  let pkG_eph = exp(g, skG_eph) in
  let mKEYACK = mkKeyAck(G, A, s, pkG_eph) in
  let sigG = sign(mKEYACK, skG_sig) in
  event groundSentKeyAck(A, G, s);
  out(c, (mKEYACK, sigG));
  let z = exp(pkA_eph, skG_eph) in
  let ksess = kdf(z, s) in
  (* Session is now in the *pending* state. *)
  (* Step 3: receive KEYCONFIRM, recompute transcript, verify MAC. *)
  in(c, (mKEYCONFIRM_bs: bitstring, tKC: bitstring));
  let mkKeyConfirm(=A, =G, =s, tau_recv: bitstring) = mKEYCONFIRM_bs in
  let tau_local = hash((mKEY_bs, mKEYACK)) in
  if tau_recv = tau_local then
  if verifymac(tKC, ksess, mKEYCONFIRM_bs) = true then
  event groundAcceptsConfirm(A, G, s, tau_local);
  (* Session is now *established*. G1 test harness: encrypt the test
     secret under K_sess.                                              *)
  out(c, senc(Ksess_test, ksess)).


(* ================================================================== *)
(* Main process: setup and unbounded replication.                     *)
(* ================================================================== *)

process
  new skA_sig: sskey;
  new skG_sig: sskey;
  let pkA_sig = spk(skA_sig) in
  let pkG_sig = spk(skG_sig) in
  out(c, (pkA_sig, pkG_sig));
  (   ! aircraft(skA_sig, pkG_sig)
    | ! ground(skG_sig, pkA_sig) )
